<view class="page" xmlns:wx="http://www.w3.org/1999/xhtml">
    <view class="page__hd">
        <view class="page__title">续费</view>
        <view class="page__desc">可以自助线上付款，即刻生效！</view>
    </view>
    <view class="page__bd">
        <view class="weui-toptips weui-toptips_warn" wx:if="{{showTopTips}}">错误提示</view>

        <view class="weui-cells__title">选择付款项目</view>
        <view class="weui-cells weui-cells_after-title">
            <radio-group bindchange="itemChange">
                <label class="weui-cell weui-check__label" wx:for="{{companyitemlist}}"  wx:key="id">
                    <radio class="weui-check" id="" value="{{index}}" checked="{{item.checked}}"/>

                    <view class="weui-cell__bd">{{item.company_item_name}}/{{item.company_item_price}}</view>
                    <view class="weui-cell__ft weui-cell__ft_in-radio" wx:if="{{item.checked}}">
                        <icon class="weui-icon-radio" type="success_no_circle" size="16"></icon>
                    </view>
                </label>
            </radio-group>
        </view>
        <button class="weui-btn mini-btn" bindtap="bindQueryPayedList" type="default" size="mini">已缴费清单</button>
    </view>
    <view class="page__ft">
        <button class="weui-btn" bindtap="bindPayment" type="primary">微信支付</button>
    </view> 

</view>