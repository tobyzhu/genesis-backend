.page {
  min-height: 100vh;
  background: #f7f7f7;
  padding: 16rpx 24rpx 40rpx;
}
.loading-tip,
.empty-tip {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 40rpx 0;
}
.task-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.hero-name {
  font-size: 34rpx;
  font-weight: 700;
}
.hero-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #999;
}
.hero-right {
  text-align: right;
}
.status-tag {
  font-size: 24rpx;
  color: #04be02;
}
.detail-link {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #576b95;
}
.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.card-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.info-row {
  display: flex;
  gap: 16rpx;
  font-size: 26rpx;
  padding: 6rpx 0;
}
.info-label {
  color: #999;
  min-width: 120rpx;
}
.attempt-item {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.attempt-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.attempt-channel,
.attempt-outcome {
  font-size: 22rpx;
  color: #04be02;
  background: rgba(4, 190, 2, 0.08);
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
}
.attempt-time {
  font-size: 22rpx;
  color: #999;
}
.attempt-delete {
  margin-left: auto;
  font-size: 22rpx;
  color: #fa5151;
}
.attempt-content {
  margin-top: 8rpx;
  font-size: 26rpx;
}
.attempt-next {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #fa8c16;
}
.form-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}
.form-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #333;
  padding-top: 12rpx;
}
.picker-value {
  font-size: 26rpx;
  padding: 12rpx 0;
}
.form-textarea {
  flex: 1;
  height: 140rpx;
  background: #f7f7f7;
  border-radius: 10rpx;
  padding: 14rpx;
  font-size: 26rpx;
  width: auto;
}
.suggest-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 8rpx 0 16rpx;
}
.suggest-btn {
  background: #04be02;
  color: #fff;
  border-radius: 10rpx;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
}
.suggest-btn.loading {
  opacity: 0.6;
}
.suggest-count {
  font-size: 24rpx;
  color: #999;
}
.suggest-card {
  border: 1rpx solid #e5e5e5;
  border-radius: 10rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}
.suggest-title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.sug-row {
  margin-bottom: 8rpx;
}
.sug-label {
  font-size: 22rpx;
  color: #04be02;
}
.sug-text {
  font-size: 26rpx;
  margin-top: 4rpx;
}
.sug-actions {
  margin-top: 4rpx;
}
.sug-use,
.sug-copy {
  font-size: 24rpx;
  color: #576b95;
  margin-right: 16rpx;
}
.sug-avoid {
  font-size: 22rpx;
  color: #fa5151;
  margin-top: 6rpx;
}
.action-row {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}
.action-btn {
  flex: 1;
  font-size: 26rpx;
  border-radius: 10rpx;
  margin: 0;
}
.action-btn.primary {
  background: #04be02;
  color: #fff;
}
.action-btn.success {
  background: #1aad19;
  color: #fff;
}
.action-btn.plain {
  background: #fff;
  color: #333;
  border: 1rpx solid #e5e5e5;
}
