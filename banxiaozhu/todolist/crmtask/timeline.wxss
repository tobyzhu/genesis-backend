.page {
  min-height: 100vh;
  background: #f7f7f7;
  padding: 16rpx 24rpx 40rpx;
}
.search-box {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.search-input {
  flex: 1;
  background: #fff;
  border-radius: 10rpx;
  padding: 14rpx 20rpx;
  font-size: 26rpx;
}
.search-btn {
  background: #04be02;
  color: #fff;
  border-radius: 10rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  line-height: 72rpx;
}
.vip-list {
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}
.vip-item {
  padding: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.vip-name {
  font-size: 28rpx;
  font-weight: 600;
}
.vip-phone {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #999;
}
.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.card-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.empty-tip {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 30rpx 0;
}
.log-item {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.log-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #999;
}
.log-content {
  margin-top: 8rpx;
  font-size: 26rpx;
}
.log-next {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #fa8c16;
}
.log-textarea {
  width: 100%;
  height: 140rpx;
  background: #f7f7f7;
  border-radius: 10rpx;
  padding: 14rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}
.form-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}
.form-label {
  width: 140rpx;
  font-size: 26rpx;
}
.picker-value {
  font-size: 26rpx;
  color: #333;
}
.save-btn {
  margin-top: 20rpx;
  background: #04be02;
  color: #fff;
  border-radius: 10rpx;
  font-size: 28rpx;
}
