<view class='page'>
  <view class='page__bd'>
    <view class="weui-cells weui-cells_after-title">
        <view class="weui-cell weui-cell_select">
            <view class="weui-cell__hd weui-cell__hd_in-select-after">
                <view class="weui-label">任务日期</view>
            </view>
            <view class="weui-cell__bd">
                <picker bindchange="bindPlanDateChange" class="weui-btn" mode="date" value="{{planbegindate}}" start="2019-01-01" end="2027-09-01" >
                    <view class="weui-select">{{planbegindate}}</view>
                </picker>
            </view>
        </view>
    </view> 

    <block wx:for="{{planvipcase}}" wx:key="uuid">
      <view class="weui-cells weui-cells_after-title">
          <navigator url="../../vip/vipcasedetail/vipcasedetail?vipuuid={{item.vipuuid}}" class="weui-cell weui-cell_access" hover-class="weui-cell_active">
              <view class="weui-cell__hd">{{item.status}}</view>
              <view class="weui-cell__bd">{{item.vname}} </view>
              <view class="weui-cell__ft weui-cell__ft_in-access">{{item.detail}}</view>
          </navigator>
      </view> 
    </block>
  </view>
</view>
