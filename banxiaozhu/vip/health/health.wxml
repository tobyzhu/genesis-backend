<view class="page">
  <view class="page__hd">
    <view class="page__title">健康档案</view>
    <view class="page__desc">客户的身体状况与护理禁忌</view>
  </view>

  <view class="add-btn-wrap">
    <button wx:if="{{!showForm}}" type="primary" size="mini" bindtap="showAddForm">+ 新增记录</button>
  </view>

  <block wx:if="{{showForm}}">
    <view class="weui-cells weui-cells_after-title" style="margin-top:0;">
      <view class="weui-cells__title">{{editing ? '编辑记录' : '新增记录'}}</view>

      <view class="weui-cell weui-cell_select">
        <view class="weui-cell__hd"><view class="weui-label">肤质</view></view>
        <view class="weui-cell__bd">
          <picker bindchange="bindSkinTypeChange" value="{{skinTypeIndex}}" range="{{skinTypeOptions}}" range-key="label">
            <view class="weui-select">{{skinTypeOptions[skinTypeIndex].label}}</view>
          </picker>
        </view>
      </view>

      <view class="weui-cell">
        <view class="weui-cell__hd"><view class="weui-label">过敏信息</view></view>
        <view class="weui-cell__bd">
          <input class="weui-input" placeholder="点击下方选项快速添加" bindinput="bindAllergiesInput" value="{{allergies}}" />
        </view>
      </view>
      <view class="tag-row">
        <view wx:for="{{allergyOptions}}" wx:key="item" class="tag {{allergies.indexOf(item) > -1 ? 'active' : ''}}" data-tag="{{item}}" data-field="allergies" bindtap="toggleTag">{{item}}</view>
      </view>

      <view class="weui-cell">
        <view class="weui-cell__hd"><view class="weui-label">身体问题</view></view>
        <view class="weui-cell__bd">
          <input class="weui-input" placeholder="点击下方选项快速添加" bindinput="bindBodyConcernsInput" value="{{bodyConcerns}}" />
        </view>
      </view>
      <view class="tag-row">
        <view wx:for="{{bodyConcernOptions}}" wx:key="item" class="tag {{bodyConcerns.indexOf(item) > -1 ? 'active' : ''}}" data-tag="{{item}}" data-field="bodyConcerns" bindtap="toggleTag">{{item}}</view>
      </view>

      <view class="weui-cell">
        <view class="weui-cell__hd"><view class="weui-label">操作禁忌</view></view>
        <view class="weui-cell__bd">
          <input class="weui-input" placeholder="点击下方选项快速添加" bindinput="bindContraindicationsInput" value="{{contraindications}}" />
        </view>
      </view>
      <view class="tag-row">
        <view wx:for="{{contraindicationOptions}}" wx:key="item" class="tag {{contraindications.indexOf(item) > -1 ? 'active' : ''}}" data-tag="{{item}}" data-field="contraindications" bindtap="toggleTag">{{item}}</view>
      </view>

      <view class="weui-cell">
        <view class="weui-cell__hd"><view class="weui-label">备注</view></view>
        <view class="weui-cell__bd">
          <input class="weui-input" placeholder="选填" bindinput="bindNotesInput" value="{{notes}}" />
        </view>
      </view>
    </view>

    <view class="action-bar">
      <button type="primary" size="mini" loading="{{saving}}" bindtap="saveRecord">保存</button>
      <button type="default" size="mini" bindtap="cancelForm">取消</button>
    </view>
  </block>

  <view class="weui-cells__title">历史记录</view>
  <block wx:if="{{loading}}">
    <view class="no-data">加载中...</view>
  </block>
  <block wx:if="{{!loading && records.length === 0}}">
    <view class="no-data">暂无健康档案记录</view>
  </block>
  <block wx:for="{{records}}" wx:key="uuid">
    <view class="record-card">
      <view class="row"><view class="rl">记录日期</view><view class="rv">{{item.record_date_display}}</view></view>
      <view class="row"><view class="rl">肤质</view><view class="rv">{{item.skin_type_label}}</view></view>
      <view class="row"><view class="rl">过敏</view><view class="rv">{{item.allergies || '-'}}</view></view>
      <view class="row"><view class="rl">身体问题</view><view class="rv">{{item.body_concerns || '-'}}</view></view>
      <view class="row"><view class="rl">禁忌</view><view class="rv">{{item.contraindications || '-'}}</view></view>
      <view class="row"><view class="rl">备注</view><view class="rv">{{item.notes || '-'}}</view></view>
      <view class="actions">
        <button type="primary" size="mini" plain="true" data-uuid="{{item.uuid}}" bindtap="editRecord">编辑</button>
        <button type="warn" size="mini" plain="true" data-uuid="{{item.uuid}}" bindtap="deleteRecord">删除</button>
      </view>
    </view>
  </block>
</view>
