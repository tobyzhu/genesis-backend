<view class="page" wx:if="{{ network_allow_flag}}">
    <view class='page__bd'>
        <view class="sub-title" >{{vip.vname}}   ({{vip.vcode}})          </view>

        <view class="weui-tab">
            <view class="weui-navbar">
                <block wx:for="{{tabs}}" wx:key="key">
                    <view id="{{index}}" class="weui-navbar__item {{activeIndex == index ? 'weui-bar__item_on' : ''}}" bindtap="tabClick">
                        <view class="weui-navbar__title">{{item.title}}</view>
                    </view>
                </block>
                <view class="weui-navbar__slider" style="left: {{sliderLeft}}px; transform: translateX({{sliderOffset}}px); -webkit-transform: translateX({{sliderOffset}}px);"></view>
            </view>
            <view class="weui-tab__panel">
                <!-- <view class="weui-tab__content" hidden="{{activeIndex != 0}}"> -->
                <view  wx:if="{{activeIndex != 1}}" >1232              
                  <block wx:for ="{{amountcardlist}}" wx:key="*this">
                      <view wx:if="{{amountcardlist.length>0}}"class="weui-cells weui-cells_after-title">
                          <radio-group bindchange="amountcardChange">
                              <label class="weui-cell weui-check__label" >
                                  <view class="weui-cell__hd">{{item.carddesc}} </view>
                              </label>
                          </radio-group>
                      </view>
                  </block>

                  <view class="weui-grids">
                    <block wx:for="{{grids}}" wx:key="id">
                        <navigator url="{{item.url}}?payccode={{payccode}}&vipuuid={{vipuuid}}&index={{index}}&suptype={{cardtype_10_list[index].suptype}}" class="weui-grid" hover-class="weui-grid_active">
                            <view class="weui-grid__label">{{item.text}}
                            </view>
                        </navigator>
                    </block>
                  </view>                
                </view>
                <!-- <view class="weui-tab__content" hidden="{{activeIndex != 1}}"> -->
                <view  hidden="{{activeIndex != 1}}">
                    <block wx:for="{{timescardlist}}" wx:key="uuid" >
                        <!-- <view class="weui-cells__title">带说明、跳转的列表项</view> -->
                        <view class="weui-cells weui-cells_after-title">
                            <navigator url="../timescard/timescard?ccode={{item.ccode}}&index={{index}}" open-type='navigate' class="weui-cell weui-cell_access" hover-class="weui-cell_active">
                                <view class="weui-cell__bd">{{item.carddesc}}</view>                            
                                <!-- <view class="weui-cell__bd">{{item.cardname}}</view>
                                <view class="weui-cell__ft weui-cell__ft_in-access">结余{{item.leftqty}}次</view> -->
                            </navigator>         
                        </view>         
                        </block>               
                </view>
                <!-- <view class="weui-tab__content" hidden="{{activeIndex != 2}}">选项三的内容</view> -->
            </view>
        </view>


        <!-- <wux-tabs defaultCurrent="tab1" controlled scroll current="{{ h_current }}" bindchange="onChange_h">
