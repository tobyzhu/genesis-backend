<view class="page" xmlns:wx="http://www.w3.org/1999/xhtml">
    <!-- <view class="page__hd">
        <view class="page__title">开卡</view>
    </view> -->
    <view class="page__bd body">
        <view class="weui-toptips weui-toptips_warn" wx:if="{{showTopTips}}">{{errormsg}}</view>

        <view class="weui-cells weui-cells_after-title">
            <view class="weui-cell weui-cell_select">
                <view class="weui-cell__hd weui-cell__hd_in-select-after">
                    <view class="weui-label">新卡卡类</view>
                </view>
                <view class="weui-cell__bd">
                    <picker bindchange="bindCardtypeChange" value="{{newcardtypeindex}}" range="{{amountcardtypelist}}" range-key='cardname'>
                        <view class="weui-select weui-select_in-select-after">{{amountcardtypelist[newcardtypeindex].cardname}}</view>
                    </picker>
                </view>
            </view>
            <view class="weui-cells weui-cells_after-title">
                <view class="weui-cell">
                    <view class="weui-cell__bd">标准售价</view>
                    <view class="weui-cell__ft">{{cardtype10list[cardtypeindex].price}}</view>
                    <view  class="weui-cell__bd"></view>
                    <view class="weui-cell__ft">欠款:</view>
                    <view class="weui-cell__ft">{{owemoney}}</view>
                </view>
            </view>

            <view class="weui-cell weui-cell_input">
                <view class="weui-cell__hd">
                    <view class="weui-label">免单金额</view>
                </view>
                <view class="weui-cell__bd">
                    <input bindinput="bindMondiscChanged" value="{{mondisc}}" class="weui-input" type='digit'/>
                </view>
            </view>

            <view class="weui-cell weui-cell_input">
                <view class="weui-cell__hd">
                    <view class="weui-label">应付金额</view>
                </view>
                <view class="weui-cell__bd">
                    <input bindinput="bindPriceChanged" value="{{price}}" class="weui-input" type='digit'/>
                </view>
            </view>

            <view class="weui-cell weui-cell_input">
                <view class="weui-cell__hd">
                    <view class="weui-label">可用金额</view>
                </view>
                <view class="weui-cell__bd">
                    <input value="{{leftmoney}}" class="weui-input" type='digit' />
                </view>
            </view>


            <block wx:if="{{earnestflag}}">
              <view class="weui-cell">
                <view class="weui-cell__hd">
                  <view class="weui-label">定金金额</view>
                </view>
                <view class="weui-cell__ft">
                  <input class="weui-input" type='digit' bindinput='bindPayedAmountChange' value='{{payedamount}}' />
                </view> 
              </view>  
              <view class="weui-cell">
                <view class="weui-cell__hd">
                  <view class="weui-label">欠款金额</view>
                </view>
                <view class="weui-cell__ft">
                  <input class="weui-input" type='digit' bindinput='bindOweAmountChanged' value='{{oweamount}}' />
                </view> 
              </view>          
            </block>

            <view  class="weui-cell weui-cell_select">
                <view class="weui-cell__hd weui-cell__hd_in-select-after">
                    <view class="weui-label">付款卡号</view>
                </view>
                <view class="weui-cell__bd">
                    <picker bindchange="bindPaycardChange" value="{{paycardindex}}" range="{{paycardlist}}" range-key='carddesc'>
                        <view class="weui-select weui-select_in-select-after">{{paycardlist[paycardindex].carddesc}}</view>
                    </picker>
                </view>
            </view>

            <view class="weui-cell weui-cell_select">
                <view class="weui-cell__hd weui-cell__hd_in-select-after">
                    <view class="weui-label">销售人员</view>
                </view>
                <view class="weui-cell__bd">
                    <picker bindchange="bindPmcodeChange" value="{{pmcodeindex}}" range="{{pmcodelist}}" range-key='ename'>
                        <view class="weui-select weui-select_in-select-after">{{pmcodelist[pmcodeindex].ename}}</view>
                    </picker>
                </view>
            </view>
            <view class="weui-cell weui-cell_select">
                <view class="weui-cell__hd weui-cell__hd_in-select-after">
                    <view class="weui-label">销售人员</view>
                </view>
                <view class="weui-cell__bd">
                    <picker bindchange="bindSeccodeChange" value="{{seccodeindex}}" range="{{seccodelist}}" range-key='ename'>
                        <view class="weui-select weui-select_in-select-after">{{seccodelist[seccodeindex].ename}}</view>
                    </picker>
                </view>
            </view>
            <view class="weui-cell weui-cell_select">
                <view class="weui-cell__hd weui-cell__hd_in-select-after">
                    <view class="weui-label">销售人员</view>
                </view>
                <view class="weui-cell__bd">
                    <picker bindchange="bindThrcodeChange" value="{{thrcodeindex}}" range="{{thrcodelist}}" range-key='ename'>
                        <view class="weui-select weui-select_in-select-after">{{thrcodelist[thrcodeindex].ename}}</view>
                    </picker>
                </view>
            </view>

            <view class="weui-cell weui-cell_select">
                <view class="weui-cell__hd weui-cell__hd_in-select-after">
                    <view class="weui-label">所属活动</view>
                </view>
                <view class="weui-cell__bd">
                    <picker bindchange="bindPromotionsChange" value="{{promotionsid}}" range="{{promotionslist}}" range-key='promotionsname'>
                        <view class="weui-select weui-select_in-select-after">{{promotionslist[promotionsindex].promotionsname}}</view>
                    </picker>
                </view>
            </view>
        </view>


        <view wx:if="{{vip.viptype==10}}" class="button-foot card-add " >
            <button class="weui-btn" type="primary" bindtap="newCardHung">确定开单</button>
        </view>


    </view>
</view>