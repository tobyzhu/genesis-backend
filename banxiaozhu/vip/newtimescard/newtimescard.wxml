<view class="page" xmlns:wx="http://www.w3.org/1999/xhtml">
    <!-- <view class="page__hd">
        <view class="page__title">开卡</view>
    </view> -->
    <view class="page__bd body">
        <view class="weui-toptips weui-toptips_warn" wx:if="{{showTopTips}}">{{errormsg}}</view>

        <view class="weui-search-bar">
          <view class="weui-search-bar__form">
            <view class="weui-search-bar__box">
              <icon class="weui-icon-search_in-box" type="search" size="14"></icon>
              <input type="text" class="weui-search-bar__input"  disabled='true' placeholder="搜索疗程项目" bindtap="wxSearchTab">
                       <view>{{ searchValue}}</view>
              </input>
            </view>
          </view>
        </view>

        <view class="weui-cells weui-cells_after-title">


            <view class="weui-cell weui-cells_after-title">
                <view class="weui-cell__hd weui-cell__hd">
                    <view class="weui-label">疗程项目</view>
                </view>
                <view class="weui-cell__bd">
                    <view class='weui-cell__ft'>{{newcardname}}</view>
                </view>
            </view>

            <view class="weui-cell weui-cell_switch">
                <view class="weui-cell__bd">是否退</view>
                <view class="weui-cell__ft">
                    <switch bindchange="bindBackflagChange" checked='{{backflagChecked}}'>{{backflagName}}  </switch>
                </view>                
            </view>              

            <view class="weui-cell weui-cell_select">
                <view class="weui-cell__hd weui-cell__hd_in-select-after">
                    <view class="weui-label">默认数量</view>
                </view>
                <view class="weui-cell__bd">
                    <picker bindchange="bindSrvPriceChange" value="{{serviecePriceIndex}}" range="{{serviecePrice}}" range-key='desc'>
                        <view class="weui-select weui-select_in-select-after">{{serviecePrice[serviecePriceIndex].desc}}</view>
                    </picker>
                </view>
            </view>

            <view class="weui-cell weui-cell_input">
                <view class="weui-cell__hd">
                    <view class="weui-label">次数</view>
                </view>
                <view class="weui-cell__bd">
                    <input bindinput="bindQtyChanged" value="{{qty}}" class="weui-input" type='digit'/>
                </view>
                <!-- <view class="weui-cell__bd">
                    <picker bindchange="bindQtyChange" value="{{qtyindex}}" range="{{qtylist}}" >
                        <view class="weui-select weui-select_in-select-after">{{qtylist[qtyindex]}}</view>
                    </picker>
                </view> -->
            </view>

            <view class="weui-cell  weui-cells_after-title">
                <view class="weui-cell__hd">
                    <view class="weui-label">单次价格</view>
                </view>
                <!-- <view class="weui-cell__bd">
                    <input bindinput="bindPriceChanged" value="{{price}}" class="weui-input" type='digit'/>
                </view> -->
                <view class="weui-cell__bd">
                    <view class='weui-cell__ft'>{{price}}</view>
                </view>                
            </view>

            <!-- <view class="weui-cell weui-cell_input">
                <view class="weui-cell__hd">
                    <view class="weui-label">免单金额</view>
                </view>
                <view class="weui-cell__bd">
                    <input bindinput="bindMondiscChanged" value="{{mondisc}}" class="weui-input" type='digit'/>
                </view>
            </view> -->

            <view class="weui-cell weui-cell_input">
            <!-- <view class="weui-cell weui-cells_after-title"> -->
                <view class="weui-cell__hd">
                    <view class="weui-label">实付金额</view>
                </view>
                <view class="weui-cell__bd ">
                    <input bindinput="bindAmountChanged" value="{{amount}}" class="weui-input" type='digit' />
                </view>
                <!-- <view class="weui-cell__bd">
                    <view class='weui-cell__ft'>{{amount}}</view>
                </view> -->
            </view>


            <view class="weui-cell weui-cell_select">
              <view class="weui-cell__hd weui-cell__hd_in-select-after">
                  <view class="weui-label">交易分类</view>
              </view>
              <view class="weui-cell__bd">
                  <picker bindchange="bindStypeChange" value="{{stypeindex}}" range="{{stypelist}}" range-key='itemvalues'>
                    <view class="weui-select weui-select_in-select-after">{{stypelist[stypeindex].itemvalues}}</view>
                  </picker>
              </view>
            </view>

            <block wx:if="{{earnestflag}}">
              <view class="weui-cell">
                <view class="weui-cell__hd">
                  <view class="weui-label">定金金额</view>
                </view>
                <view class="weui-cell__ft">
                  <input class="weui-input" type='digit' bindinput='bindPayedAmountChange' value='{{payedamount}}' />
                </view> 
              </view>  
              <view class="weui-cell">
                <view class="weui-cell__hd">
                  <view class="weui-label">欠款金额</view>
                </view>
                <view class="weui-cell__ft">
                  <input class="weui-input" type='digit' bindinput='bindOweAmountChanged' value='{{oweamount}}' />
                </view> 
              </view>          
            </block>

            <view  class="weui-cell weui-cell_select">
                <view class="weui-cell__hd weui-cell__hd_in-select-after">
                  <view class="weui-label">付款卡号</view>
                </view>
                <view class="weui-cell__bd">
                  <picker bindchange="bindPaycardChange" value="{{paycardindex}}" range="{{paycardlist}}" range-key='carddesc'>
                    <view class="weui-select weui-select_in-select-after">{{paycardlist[paycardindex].carddesc}}</view>
                  </picker>
                </view>
            </view>

            <view class="weui-cell weui-cell_select">
                <view class="weui-cell__hd weui-cell__hd_in-select-after">
                    <view class="weui-label">销售人员</view>
                </view>
                <view class="weui-cell__bd">
                    <picker bindchange="bindPmcodeChange" value="{{pmcodeindex}}" range="{{pmcodelist}}" range-key='ename'>
                        <view class="weui-select weui-select_in-select-after">{{pmcodelist[pmcodeindex].ename}}</view>
                    </picker>
                </view>
            </view>
            <view class="weui-cell weui-cell_select">
                <view class="weui-cell__hd weui-cell__hd_in-select-after">
                    <view class="weui-label">销售人员</view>
                </view>
                <view class="weui-cell__bd">
                  <picker bindchange="bindSeccodeChange" value="{{seccodeindex}}" range="{{seccodelist}}" range-key='ename'>
                    <view class="weui-select weui-select_in-select-after">{{seccodelist[seccodeindex].ename}}</view>
                  </picker>
                </view>
            </view>
            <view class="weui-cell weui-cell_select">
                <view class="weui-cell__hd weui-cell__hd_in-select-after">
                    <view class="weui-label">销售人员</view>
                </view>
                <view class="weui-cell__bd">
                    <picker bindchange="bindThrcodeChange" value="{{thrcodeindex}}" range="{{thrcodelist}}" range-key='ename'>
                      <view class="weui-select weui-select_in-select-after">{{thrcodelist[thrcodeindex].ename}}</view>
                    </picker>
                </view>
            </view>

            <view class="weui-cell weui-cell_select">
                <view class="weui-cell__hd weui-cell__hd_in-select-after">
                    <view class="weui-label">所属活动</view>
                </view>
                <view class="weui-cell__bd">
                    <picker bindchange="bindPromotionsChange" value="{{promotionsid}}" range="{{promotionslist}}" range-key='promotionsname'>
                        <view class="weui-select weui-select_in-select-after">{{promotionslist[promotionsindex].promotionsname}}</view>
                    </picker>
                </view>
            </view>
            <view class="weui-cell weui-cell_input">
                <view class="weui-cell__hd">
                    <view class="weui-label">备注</view>
                </view>
                <view class="weui-cell__bd">
                    <input bindinput="bindRemarkChanged" value="{{remark}}"  class="weui-input" placeholder="请输入备注信息" />
                </view>
            </view>

        </view>

        <view class="button-foot card-add " >
            <button class="weui-btn" type="primary" bindtap="newTimesCardHung">开单确认</button>
        </view>

    </view>
</view>
