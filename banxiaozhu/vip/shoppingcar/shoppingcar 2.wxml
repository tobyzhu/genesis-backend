<view class="page">
    <view class="page__bd">

        <wux-cell-group>
            <view class="sub-title">服务项目清单</view>
            <view class="body" wx:if="{{item_s_list.length==0}}">购物车里面没有服务项目</view>
            <block wx:for="{{item_s_list}}" wx:key="uuid">
              <wux-swipe-action autoClose right="{{ right }}" id="{{item.uuid}}" bind:click="onShoppingCartClick" >
                <wux-wing-blank size="default">
                    <wux-card title="{{item.itemname}}" extra="{{item.stypename}}">
                        <view slot="header">{{item.itemname}}</view>
                        <view slot="body" title='price'>{{item.qty}}*{{item.price}}*{{item.secdisc}}-{{item.mondisc}}={{item.amount}} </view>
                        <!-- <view slot="body">应付金额{{item.amount}}  可用金额{{item.leftmeny}}</view> -->
                        <view slot="footer">{{item.pmcode}} {{item.seccode}}{{item.thrcode}}</view>
                    </wux-card>
                </wux-wing-blank>
              </wux-swipe-action>                
            </block>
        </wux-cell-group>

        <wux-cell-group>
            <view class="sub-title">商品销售清单</view>
            <view class="sub-title" wx:if="{{item_g_list.length==0}}">购物车里面没有商品</view>
            <block wx:for="{{item_g_list}}" wx:key="uuid">
              <wux-swipe-action autoClose right="{{ right }}" id="{{item.uuid}}" bind:click="onShoppingCartClick" >
                <wux-wing-blank size="default">
                    <wux-card title="{{item.itemname}}" extra="{{item.stypename}}">
                        <view slot="header">{{item.itemname}}({{item.itemcode}})</view>
                        <view slot="body">{{item.qty}}*{{item.price}}*{{item.secdisc}}-{{item.mondisc}}={{item.amount}} </view>
                        <view slot="body">付款卡号{{item.payccode}}  </view>
                        <view slot="footer">{{item.pmcode}} {{item.seccode}}{{item.thrcode}}</view>
                        <view slot="footer">{{item.pmcode}} {{item.seccode}}{{item.thrcode}}</view>
                    </wux-card>
                </wux-wing-blank>
              </wux-swipe-action>                
            </block>
        </wux-cell-group>
    </view>

    <view class="button-foot card-add " >
        <button class="weui-btn" type="primary" id='G' disable="{{button_disable}}" bindtap="confirmHung">确认开单</button>
    </view>

</view>