    <view class="weui-cells weui-cells_after-title">
        <view class="weui-cell">
            <view class="weui-cell__bd">疗程卡项</view>
            <view class="weui-cell__ft">{{cardname}}</view>
        </view>
    </view>
    <view class="weui-cells weui-cells_after-title">
        <view class="weui-cell">
            <view class="weui-cell__bd">结余次数</view>
            <view class="weui-cell__ft">{{leftqty}}</view>
        </view>
    </view>
    <view class="weui-cells weui-cells_after-title">
        <view class="weui-cell">
            <view class="weui-cell__bd">当前状态</view>
            <view wx:if="{{payccodestatus=='P'}}" class="weui-cell__ft">挂账</view>
            <view wx:if="{{payccodestatus=='O'}}" class="weui-cell__ft">已结</view>
        </view>
    </view>
    <view class="weui-cells weui-cells_after-title">
        <view class="weui-cell">
            <view class="weui-cell__bd">单价</view>
            <view class="weui-cell__ft">{{consumeprice}}</view>
        </view>
    </view>
    <view class="weui-cells weui-cells_after-title">      
        <view class="weui-cell weui-cell_select">
            <view class="weui-cell__hd weui-cell__hd_in-select-after">
                <view class="weui-label">今日消费</view>
            </view>
            <view class="weui-cell__bd">
                <picker bindchange="bindConsumeqtyChange" value="{{consumeqty}}" range="{{qtylist}}">
                    <view class="weui-select weui-select_in-select-after">{{qtylist[qtyindex]}}</view>
                </picker>
            </view>
        </view>
    </view>

