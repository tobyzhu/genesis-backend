<!--business/vip/vip.wxml-->
<view class="page">
    <view class="page__hd">
        <view class="page__title">{{vip.vname}}</view>

        <view class="page__desc">
            <view wx:if="{{vip.viptype==10}}" >会员号:{{vip.vcode}}</view>
            <view wx:if="{{vip.viptype==20}}" >散客</view>
            <view wx:if="{{vip.viptype==30}}" >潜在客户</view>


            <view class='shipping-phone' bindtap='callGetPhone' data-getPhone='{{vip.mtcode}}'>手机：
              <text>{{vip.mtcode}}</text>
            </view>
            <view wx:if="{{vip.indate}}">入会日期：{{vip.indate}}</view>
            <view wx:if="{{vip.sourceName}}">来店渠道：{{vip.sourceName}}</view>
            <view wx:if="{{vip.viplevelName || vip.viplevel}}">等级：{{vip.viplevelName || vip.viplevel}}</view>
        </view>
        <view wx:if="{{vip.tags}}" class="page__desc">
            <view class="vip-tags-wrap">
                <block wx:for="{{tagList}}" wx:key="item">
                    <view class="vip-tag">{{item}}</view>
                </block>
            </view>
        </view>
    </view>


    <view wx:if="{{vip}}" class="page__bd page__bd_spacing">
        <view class="weui-grids">
            <block wx:for="{{grids}}" wx:key="id">
                <navigator url="{{item.url}}" class="weui-grid" hover-class="weui-grid_active">
                    <image class="weui-grid__icon" src="{{item.image}}" />
                    <view class="weui-grid__label">{{item.text}}
                    </view>
                </navigator>
            </block>
        </view>
    </view>

    <!-- <view class="page__ft">
        <image src="images/icon_footer.png" style="width: 84px; height: 19px;"></image>
    </view> -->
</view>
