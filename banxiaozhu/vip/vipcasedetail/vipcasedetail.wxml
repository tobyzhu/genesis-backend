                    <view class="weui-form-preview__item">
                        <view class="weui-form-preview__label">时间</view>
                        <view class="weui-form-preview__value_in-hd">{{item.created_date}}</view>
                    </view>
                </view> -->

                <view class="weui-form-preview__bd">
                    <view class="weui-form-preview__item">
                        <view class="weui-form-preview__label">{{item.created_date}}</view>
                        <view class="weui-form-preview__value">{{item.detail}}</view>
                    </view>
                    <!-- <view class="weui-form-preview__item">
                        <view class="weui-form-preview__label">员工</view>
                        <view class="weui-form-preview__value">{{item.ecode}}</view>
                    </view>
                    <view class="weui-form-preview__item">
