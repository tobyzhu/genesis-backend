# 复制为 `.env` 后填写（`.env` 已被 git 忽略，勿提交）
# cp .env.example .env

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# --- 默认数据库（Django ORM）---
DB_NAME=youlan
DB_USER=sa
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- 微信 / 支付（与公众平台、商户平台一致）---
# 主小程序/公众号（帮小主等）
WECHAT_APPID=
WECHAT_APP_SECRET=
# 与商户平台 API 密钥可相同或不同，按你方实际配置
WECHAT_MCH_ID=
WECHAT_API_KEY=
WECHAT_TOKEN=
WECHAT_USERNAME=
WECHAT_ENCODING_AES_KEY=
WECHAT_UFDODER_URL=https://api.mch.weixin.qq.com/pay/unifiedorder
WECHAT_NOTIFY_URL=http://localhost:8080/wechat/payment_notify
WECHAT_SPBILL_CREATE_IP=127.0.0.1
# 统一下单结果回调完整 URL（若与 NOTIFY_URL 不同可单独设）
WECHAT_PAY_NOTIFY_URL=

# 多小程序：appcode 100/200 覆盖项（不填则回退到上面 WECHAT_*）
WECHAT_APP_100_APPID=
WECHAT_APP_100_SECRET=
WECHAT_APP_100_TOKEN=
WECHAT_APP_100_USERNAME=
WECHAT_APP_100_AES_KEY=
WECHAT_APP_200_APPID=
WECHAT_APP_200_SECRET=
WECHAT_APP_200_TOKEN=
WECHAT_APP_200_USERNAME=
WECHAT_APP_200_AES_KEY=

# 其他应用（如美疗师端）
WECHAT_ARTISAN_APPID=
WECHAT_ARTISAN_APP_SECRET=

# 微信退款等证书（可选，默认 wechat/cacert/ 下文件名）
# WECHAT_APICLIENT_CERT=
# WECHAT_APICLIENT_KEY=

# --- 历史/同步用 MySQL（datamanage、jmj、goods 直连）---
LEGACY_MYSQL_USER=sa
LEGACY_MYSQL_PASSWORD=
# jmj 读库曾用 root 时设置，否则与 LEGACY_MYSQL_USER 相同
# JMJ_IMPORT_READ_USER=

YOULAN_SYNC_HOST=
YOULAN_SYNC_DB=youlan

DIESHANG_SYNC_HOST=
DIESHANG_SYNC_DB=youlan

JMJ_IMPORT_READ_HOST=
JMJ_IMPORT_READ_DB=genesis
JMJ_IMPORT_WRITE_HOST=
JMJ_IMPORT_WRITE_DB=multistore

# --- 后台「智能助手」LLM ---
# DeepSeek（默认）
# DEEPSEEK_API_KEY=
# DEEPSEEK_API_BASE=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# Cursor：对话请求走 OpenAI 兼容的 chat/completions，需同时配置网关 Base + 密钥。
# CURSOR_API_KEY=          # 发给网关的密钥（可与 OpenAI/OpenRouter 等一致）
# CURSOR_OPENAI_BASE=      # 必填。不含 /chat/completions，如 https://api.openai.com/v1
# CURSOR_MODEL=gpt-4o-mini # 须为该网关支持的 model id
# CURSOR_HTTP_AUTH=bearer  # 可选 bearer | basic（少数网关要求 Basic）
#
# 若仅有 Cursor Dashboard「Integrations」的 crsr_* 密钥：该密钥用于 api.cursor.com 的 Cloud Agents 等接口，
# 不提供本助手使用的 /v1/chat/completions；数据库问答请用 DeepSeek，或为对话另配 OpenAI 兼容服务。
